---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found." noindex>
  <PageHero eyebrow="Error 404" lines={['Signal', 'lost']} intro="This page may have moved, or the link might be out of date. Try one of these instead.">
    <div class="mt-10 flex flex-wrap gap-3 pb-24">
      <a href="/" class="btn btn-primary">Home</a>
      <a href="/work/" class="btn btn-ghost">Work</a>
      <a href="/contact/" class="btn btn-ghost">Contact</a>
    </div>
  </PageHero>
</BaseLayout>
