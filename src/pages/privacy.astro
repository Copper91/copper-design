---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout title="Privacy notice" description="How Copper Design handles the personal information you share through this website.">
  <PageHero eyebrow="Legal" lines={['Privacy']} />

  <div class="container-x mt-12 max-w-3xl space-y-8 text-muted">
    <!-- TODO(owner): replace this placeholder with a reviewed privacy notice (business name, address, legal basis, data processors, retention, rights). Have it checked before launch. -->
    <p class="rounded-2xl border border-line-strong p-5 text-sm text-fg">
      <strong>Placeholder:</strong> this notice is a draft outline and has not yet been finalised. It will be replaced with the full privacy notice before the site launches.
    </p>
    <section aria-labelledby="p1">
      <h2 id="p1" class="text-2xl font-medium text-fg">What we collect</h2>
      <p class="mt-3">When you send an enquiry we receive the details you enter in the form: your name, email address, and anything you tell us about your project.</p>
    </section>
    <section aria-labelledby="p2">
      <h2 id="p2" class="text-2xl font-medium text-fg">How we use it</h2>
      <p class="mt-3">We use those details only to reply to your enquiry and, if we work together, to run your project. We don’t sell your information.</p>
    </section>
    <section aria-labelledby="p3">
      <h2 id="p3" class="text-2xl font-medium text-fg">Third parties</h2>
      <p class="mt-3">Form submissions are delivered through a form-handling service. The provider, and any analytics used on this site, will be named here.</p>
    </section>
    <section aria-labelledby="p4">
      <h2 id="p4" class="text-2xl font-medium text-fg">Your choices</h2>
      <p class="mt-3">You can ask us what information we hold about you, or ask us to delete it, by getting in touch through the <a class="underline" href="/contact/">contact page</a>.</p>
    </section>
    <p class="text-sm">Last updated: draft, not yet in effect.</p>
  </div>
</BaseLayout>
