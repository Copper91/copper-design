---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Thank you" description="Your enquiry has been sent to Copper Design." noindex>
  <section class="container-x py-24 md:py-40" aria-labelledby="page-title">
    <p class="eyebrow">Message sent</p>
    <h1 id="page-title" class="mt-4 max-w-[14ch] font-display text-5xl leading-[0.95] md:text-8xl">Thank you — we’ve got it.</h1>
    <p class="mt-8 max-w-xl text-lg text-muted">We’ll read your enquiry properly and reply with a few questions and next steps.</p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/work/" class="btn btn-primary">See the work</a>
      <a href="/" class="btn btn-ghost">Back to home</a>
    </div>
  </section>
</BaseLayout>
