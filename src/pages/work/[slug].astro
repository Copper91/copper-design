---
import { u } from '../../lib/url';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectArt from '../../components/ProjectArt.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props { project: Project; next: Project }
const { project, next } = Astro.props;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  description: project.summary,
  creator: { '@type': 'Organization', name: 'Copper Design' },
  dateCreated: project.year,
};
---

<BaseLayout title={`${project.title} (concept)`} description={`Concept project: ${project.summary}`} jsonLd={ld}>
  <article>
    <header class="container-x pt-14 md:pt-24">
      <nav aria-label="Breadcrumb" class="text-sm text-muted">
        <ol class="flex gap-2">
          <li><a href={u("/work/")} class="link-underline">Work</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="truncate">{project.sector}</li>
        </ol>
      </nav>
      <p class="eyebrow mt-10">Concept project · {project.categories.join(' · ')}</p>
      <h1 class="section-title mt-6 max-w-[22ch] text-[clamp(2.2rem,5vw,4.25rem)]">{project.title}</h1>
      <p class="mt-6 max-w-2xl text-lg text-muted">{project.summary}</p>
    </header>

    <div class="container-x mt-12 md:mt-16">
      <div class="aspect-[4/3] overflow-hidden rounded-[1.25rem] border rule md:aspect-[16/8]">
        <ProjectArt variant={project.art} uid="hero-art" label={`Abstract key artwork for ${project.title}`} />
      </div>
      <p class="mt-3 text-xs text-subtle">Sample concept project created by Copper Design to demonstrate approach. Not client work.</p>
    </div>

    <div class="container-x mt-16 grid gap-12 md:mt-24 md:grid-cols-12">
      <dl class="grid grid-cols-2 gap-6 self-start text-sm text-muted md:col-span-4 md:grid-cols-1">
        <div><dt class="eyebrow eyebrow-plain">Sector</dt><dd class="mt-2">{project.sector}</dd></div>
        <div><dt class="eyebrow eyebrow-plain">Year</dt><dd class="mt-2">{project.year}</dd></div>
        <div><dt class="eyebrow eyebrow-plain">Type</dt><dd class="mt-2">Self-initiated concept</dd></div>
        <div>
          <dt class="eyebrow eyebrow-plain">Deliverables</dt>
          <dd class="mt-2"><ul class="space-y-1">{project.deliverables.map((d) => <li>{d}</li>)}</ul></dd>
        </div>
      </dl>
      <div class="space-y-12 md:col-span-7 md:col-start-6">
        <section aria-labelledby="brief-title">
          <h2 id="brief-title" class="text-3xl font-medium">The brief</h2>
          <p class="mt-4 text-lg text-muted">{project.brief}</p>
        </section>
        <section aria-labelledby="approach-title">
          <h2 id="approach-title" class="text-3xl font-medium">Approach</h2>
          <ol class="mt-6 space-y-6">
            {project.approach.map((a, i) => (
              <li class="flex gap-5 border-t rule pt-6">
                <span class="text-sm text-subtle" aria-hidden="true">0{i + 1}</span>
                <p class="text-muted">{a}</p>
              </li>
            ))}
          </ol>
        </section>
      </div>
    </div>
  </article>

  <section class="container-x mt-24 md:mt-32" aria-labelledby="next-title">
    <h2 id="next-title" class="eyebrow">Next project</h2>
    <div class="mt-8 max-w-2xl"><ProjectCard project={next} /></div>
  </section>

  <CtaBand />
</BaseLayout>
