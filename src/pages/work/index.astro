---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { projects, categories } from '../../data/projects';
---

<BaseLayout
  title="Work"
  description="Sample concept projects from Copper Design: brand identity, social media kits, poster campaigns, web visuals and AI-assisted concept imagery."
>
  <section class="container-x pt-16 md:pt-28" aria-labelledby="page-title">
    <p class="eyebrow" data-reveal>Work</p>
    <h1 id="page-title" class="mt-4 max-w-[16ch] font-display text-5xl leading-[0.95] md:text-8xl" data-reveal>Concept projects, built end to end.</h1>
    <p class="mt-8 max-w-2xl text-lg text-muted" data-reveal>
      Every piece here is a self-initiated sample project — an imagined brief, worked through properly — so you can see how we approach a problem. Real client case studies will be added with permission.
      <!-- TODO(owner): replace sample projects with real case studies as they are approved. -->
    </p>
  </section>

  <section class="container-x mt-12 md:mt-16" aria-label="Projects">
    <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter projects by category" data-filters hidden>
      <button type="button" class="filter-btn" aria-pressed="true" data-filter="all">All</button>
      {categories.map((c) => <button type="button" class="filter-btn" aria-pressed="false" data-filter={c}>{c}</button>)}
    </div>
    <p class="sr-only" aria-live="polite" data-filter-status></p>

    <div class="mt-10 grid gap-x-6 gap-y-14 md:grid-cols-2 lg:grid-cols-3" data-grid>
      {projects.map((p, i) => <ProjectCard project={p} headingLevel="h2" delay={(i % 3) * 90} />)}
    </div>
    <p class="mt-10 text-muted" data-empty hidden>No projects in this category yet.</p>
  </section>

  <CtaBand title="Want something like this for your brand?" />
</BaseLayout>

<style>
  .filter-btn {
    min-height: 44px;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-size: 0.875rem;
    color: var(--ink);
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }
  .filter-btn:hover { border-color: var(--accent-text); }
  .filter-btn[aria-pressed='true'] { background: var(--cta-bg); color: var(--cta-fg); border-color: transparent; }
</style>

<script>
  // Progressive enhancement: filters only appear when JS runs; without JS all projects are listed.
  const bar = document.querySelector<HTMLElement>('[data-filters]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-grid] > article'));
  const status = document.querySelector<HTMLElement>('[data-filter-status]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  if (bar) {
    bar.hidden = false;
    const buttons = Array.from(bar.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const apply = (f: string) => {
      let shown = 0;
      for (const c of cards) {
        const match = f === 'all' || (c.dataset.categories ?? '').split('|').includes(f);
        c.hidden = !match;
        if (match) {
          shown++;
          c.classList.add('is-visible');
        }
      }
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === f)));
      if (empty) empty.hidden = shown > 0;
      if (status) status.textContent = `Showing ${shown} project${shown === 1 ? '' : 's'}${f === 'all' ? '' : ` in ${f}`}.`;
      const url = new URL(location.href);
      if (f === 'all') url.searchParams.delete('filter');
      else url.searchParams.set('filter', f);
      history.replaceState(null, '', url);
    };
    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter ?? 'all')));
    const initial = new URL(location.href).searchParams.get('filter');
    if (initial && buttons.some((b) => b.dataset.filter === initial)) apply(initial);
  }
</script>
