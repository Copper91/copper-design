---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Marquee from '../components/Marquee.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ServicesBento from '../components/ServicesBento.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Packages from '../components/Packages.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { projects } from '../data/projects';
import { aiPrinciples, faqs } from '../data/home';
import { site, startProjectHref, bookCallHref } from '../data/site';

const featured = projects.slice(0, 4);
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout
  title={site.name}
  description="Copper Design is a graphic and AI-assisted design studio: brand identity and logos, social media graphics, marketing materials, web visuals and AI concept imagery. Start a project or book a call."
  jsonLd={faqLd}
>
  <!-- Hero -->
  <section class="relative overflow-hidden" aria-labelledby="hero-title">
    <div aria-hidden="true" class="hero-orb pointer-events-none absolute -right-[18vw] -top-[12vw] h-[62vw] w-[62vw] max-h-[56rem] max-w-[56rem] rounded-full"></div>
    <div class="container-x relative pb-16 pt-16 md:pb-28 md:pt-28">
      <p class="eyebrow" data-reveal>Graphic &amp; AI-assisted design studio</p>
      <h1 id="hero-title" class="mt-6 max-w-[14ch] font-display text-[clamp(3rem,10.5vw,10rem)] font-normal leading-[0.92] tracking-[-0.035em]" data-reveal style="--reveal-delay:80ms">
        Design with a <em class="metal-text font-medium not-italic md:italic">hand&#8209;finished</em> edge.
      </h1>
      <div class="mt-10 grid gap-8 md:mt-14 md:grid-cols-12 md:items-end" data-reveal style="--reveal-delay:160ms">
        <p class="max-w-xl text-lg text-muted md:col-span-6 md:text-xl">
          Brand identities, social graphics, marketing materials and web visuals — explored quickly with AI, then crafted properly by a designer.
        </p>
        <div class="flex flex-wrap gap-3 md:col-span-6 md:justify-end">
          <a href={startProjectHref} class="btn btn-primary px-8 text-base">
            Start a project
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
          </a>
          <a href={bookCallHref} class="btn btn-ghost px-8 text-base">Book a call</a>
        </div>
      </div>
    </div>
  </section>

  <Marquee />

  <!-- Selected work -->
  <section class="container-x mt-24 md:mt-36" aria-labelledby="work-title">
    <SectionHeading
      id="work-title"
      eyebrow="Selected work"
      title="Concept projects that show how we think."
      intro="We’re a new studio, so these are self-initiated sample projects — each one a real brief we set ourselves and worked through end to end."
    />
    <div class="mt-12 grid gap-x-6 gap-y-14 md:mt-16 md:grid-cols-2">
      {featured.map((p, i) => <ProjectCard project={p} size={i === 0 ? 'large' : 'default'} delay={(i % 2) * 100} />)}
    </div>
    <div class="mt-14 flex justify-center">
      <a href="/work/" class="btn btn-ghost px-8">See all work</a>
    </div>
  </section>

  <!-- Services bento -->
  <section class="container-x mt-24 md:mt-36" aria-labelledby="services-title">
    <SectionHeading
      id="services-title"
      eyebrow="Services"
      title="Everything your brand needs to look the part."
      intro="Five core services, combined however your project needs. One studio, one visual standard, from logo to launch."
    />
    <div class="mt-12 md:mt-16">
      <ServicesBento />
    </div>
  </section>

  <!-- How AI fits -->
  <section class="mt-24 border-y rule bg-surface py-20 md:mt-36 md:py-32" aria-labelledby="ai-title">
    <div class="container-x grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5" data-reveal>
        <p class="eyebrow">How AI fits our process</p>
        <h2 id="ai-title" class="mt-4 font-display text-4xl leading-[1.02] md:text-6xl">A faster sketchbook. Never the designer.</h2>
        <p class="mt-6 max-w-md text-muted md:text-lg">
          AI tools help us explore more ground in less time. Taste, decisions and finishing stay with people — which is where good design actually happens.
        </p>
      </div>
      <!-- TODO(owner): confirm these AI-use commitments match how you work. -->
      <ul class="grid gap-4 sm:grid-cols-2 md:col-span-7">
        {aiPrinciples.map((a, i) => (
          <li class="rounded-3xl border rule bg-paper p-6 md:p-8" data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <span class="font-display text-sm text-accent" aria-hidden="true">0{i + 1}</span>
            <h3 class="mt-4 font-display text-2xl leading-tight">{a.title}</h3>
            <p class="mt-3 text-sm text-muted">{a.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Process -->
  <section class="container-x mt-24 md:mt-36" aria-labelledby="process-title">
    <SectionHeading
      id="process-title"
      eyebrow="Process"
      title="Four steps. No guesswork."
      intro="A clear route from first message to final files, with agreed scope and feedback rounds so you always know where things stand."
    />
    <div class="mt-12 md:mt-16"><ProcessSteps /></div>
  </section>

  <!-- Packages -->
  <section class="container-x mt-24 md:mt-36" aria-labelledby="packages-title" id="packages">
    <SectionHeading
      id="packages-title"
      eyebrow="Packages"
      title="Ways to work together."
      intro="Starting points for the most common projects. Every project gets a fixed quote before work begins."
    />
    <div class="mt-12 md:mt-16"><Packages /></div>
  </section>

  <!-- FAQ -->
  <section class="container-x mt-24 grid gap-12 md:mt-36 md:grid-cols-12" aria-labelledby="faq-title">
    <div class="md:col-span-4" data-reveal>
      <p class="eyebrow">FAQ</p>
      <h2 id="faq-title" class="mt-4 font-display text-4xl leading-[1.02] md:text-5xl">Good questions.</h2>
    </div>
    <div class="md:col-span-8"><Faq /></div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .hero-orb {
    background:
      radial-gradient(closest-side, color-mix(in oklab, var(--copper) 55%, transparent), transparent 70%),
      conic-gradient(from 200deg, transparent, color-mix(in oklab, var(--copper-deep) 35%, transparent), transparent 60%);
    opacity: 0.55;
    filter: blur(20px);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-orb { animation: drift 18s ease-in-out infinite alternate; }
  }
  @keyframes drift {
    to { transform: translate3d(-4%, 6%, 0) scale(1.06); }
  }
</style>
