---
import { u } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCards from '../components/ServiceCards.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBand from '../components/CtaBand.astro';
import { projects } from '../data/projects';
import { startProjectHref } from '../data/site';
---

<BaseLayout
  title="Copper Design"
  description="Copper Design is a creative studio for brand identity, graphic design, AI creative and motion graphics. Bold identities, cinematic visuals and digital experiences that stick."
>
  <!-- Hero -->
  <section class="relative overflow-hidden" aria-labelledby="hero-title">
    <div aria-hidden="true" class="hero-bg pointer-events-none absolute inset-0">
      <div class="hero-glow"></div>
      <svg class="hero-shapes" viewBox="0 0 1440 820" preserveAspectRatio="xMidYMid slice" fill="none" stroke="currentColor" stroke-width="1">
        <path class="s1" d="M880 96 L1000 156 L866 204 Z"></path>
        <rect class="s2" x="1010" y="120" width="300" height="300" rx="40" transform="rotate(-14 1160 270)"></rect>
        <circle class="s3" cx="1055" cy="610" r="64"></circle>
        <path class="s4" d="M1250 790 L1330 710"></path>
      </svg>
    </div>

    <div class="container-x relative flex min-h-[calc(100svh-4rem)] flex-col justify-center pb-16 pt-20 md:min-h-[calc(100svh-4.5rem)] md:pt-24">
      <h1 id="hero-title" class="display text-[clamp(3.4rem,11vw,9.5rem)]" data-reveal>
        <span class="block">Design</span>
        <span class="block">Without</span>
        <span class="block text-subtle">Limits</span>
      </h1>
      <p class="mt-8 max-w-xl text-base text-muted md:text-lg" data-reveal style="--reveal-delay:100ms">
        Bold identities, cinematic visuals, and digital experiences that stick — made for brands that refuse to blend in.
      </p>
      <div class="mt-10 flex flex-wrap gap-3" data-reveal style="--reveal-delay:180ms">
        <a href={u("/work/")} class="btn btn-primary">
          <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><rect width="12" height="12" rx="2" fill="currentColor"></rect></svg>
          View portfolio
        </a>
        <a href={startProjectHref} class="btn btn-ghost">
          <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="0.7" y="0.7" width="10.6" height="10.6" rx="2"></rect></svg>
          Start a project
        </a>
      </div>
      <a href="#services" class="eyebrow mt-20 self-start hover:text-fg md:mt-28">Scroll to explore</a>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="container-x mt-16 md:mt-28" aria-labelledby="services-title">
    <SectionHeading id="services-title" eyebrow="Services" title="Four disciplines, one standard." />
    <div class="mt-14"><ServiceCards /></div>
  </section>

  <!-- About -->
  <section class="container-x mt-32 md:mt-44" aria-labelledby="about-title">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-7" data-reveal>
        <p class="eyebrow">About Copper Design</p>
        <h2 id="about-title" class="section-title mt-6 max-w-[16ch]">Where creativity meets technology.</h2>
        <!-- TODO(owner): confirm this studio description (taken from your style reference) is how you want to be described. -->
        <p class="mt-8 max-w-xl text-muted">
          Copper Design is a Black-owned creative studio working across graphic design, branding, illustration, motion and editorial. Every project begins with a clear idea and a point of view, then moves through thoughtful composition and craft into visuals that connect with real audiences — and hold up long after launch. The goal is always the same: work that feels intentional, distinctive, and unmistakably yours.
        </p>
        <a href={u("/about/")} class="btn btn-ghost mt-10">More about the studio</a>
      </div>
    </div>
  </section>

  <!-- Signature projects: horizontal scroll -->
  <section class="mt-32 md:mt-44" aria-labelledby="projects-title">
    <div class="container-x">
      <SectionHeading id="projects-title" eyebrow="Signature projects" title="A cinematic scroll through the archive." />
      <p class="mt-4 text-sm text-subtle" data-reveal>Sample concept projects. Scroll sideways or use the arrow buttons.</p>
    </div>
    <div class="relative mt-12">
      <ul class="h-scroll" data-scroller tabindex="0" aria-label="Signature projects, scrollable list">
        {projects.map((p, i) => (
          <li><ProjectCard project={p} index={i} tall delay={Math.min(i, 3) * 80} /></li>
        ))}
        <li class="flex">
          <a href={u("/work/")} class="card card-hover flex aspect-[4/5] w-full flex-col items-start justify-end p-6 md:p-8">
            <span class="eyebrow eyebrow-plain">All work</span>
            <span class="mt-3 text-2xl font-medium" style="font-family: var(--font-heading)">See every project →</span>
          </a>
        </li>
      </ul>
      <div class="container-x mt-6 flex justify-end gap-2">
        <button type="button" class="scroll-btn" data-scroll="-1" aria-label="Scroll projects left">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M13 8H3M7 4L3 8l4 4"></path></svg>
        </button>
        <button type="button" class="scroll-btn" data-scroll="1" aria-label="Scroll projects right">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
        </button>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="container-x mt-32 md:mt-44" aria-labelledby="process-title">
    <SectionHeading id="process-title" eyebrow="Creative process" title="Five moves, from blank page to launch." />
    <div class="mt-16"><ProcessSteps /></div>
  </section>

  <!-- Testimonials: hidden until real quotes exist -->
  <Testimonials />

  <CtaBand />
</BaseLayout>

<style>
  .hero-glow {
    position: absolute;
    left: 50%;
    top: 40%;
    width: min(90vw, 70rem);
    aspect-ratio: 1.4;
    transform: translate(-50%, -50%);
    background: radial-gradient(closest-side, rgb(255 255 255 / 0.075), transparent);
  }
  .hero-shapes {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: rgb(255 255 255 / 0.09);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-shapes .s1 { animation: float 14s ease-in-out infinite alternate; transform-origin: 930px 150px; }
    .hero-shapes .s2 { animation: float 18s ease-in-out infinite alternate-reverse; }
    .hero-shapes .s3 { animation: float 12s ease-in-out infinite alternate; }
  }
  @keyframes float {
    to { transform: translate3d(0, -18px, 0) rotate(4deg); }
  }
  .scroll-btn {
    display: inline-flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    transition: border-color 0.2s, opacity 0.2s;
  }
  .scroll-btn:hover { border-color: var(--fg); }
  .scroll-btn:disabled { opacity: 0.35; cursor: default; }
  [data-scroller]:focus-visible { outline-offset: -2px; }
</style>

<script>
  // Arrow buttons + keyboard for the horizontal project scroller. Re-runs after client-side navigation.
  document.addEventListener('astro:page-load', () => {
    const scroller = document.querySelector<HTMLElement>('[data-scroller]');
    if (!scroller) return;
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-scroll]');
    const step = () => (scroller.querySelector('li')?.getBoundingClientRect().width ?? 320) + 16;
    const smooth: ScrollBehavior = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
    const update = () => {
      const max = scroller.scrollWidth - scroller.clientWidth - 2;
      buttons.forEach((b) => (b.disabled = b.dataset.scroll === '-1' ? scroller.scrollLeft <= 2 : scroller.scrollLeft >= max));
    };
    buttons.forEach((b) =>
      b.addEventListener('click', () => scroller.scrollBy({ left: Number(b.dataset.scroll) * step(), behavior: smooth })),
    );
    scroller.addEventListener('scroll', update, { passive: true });
    update();
  });
</script>
