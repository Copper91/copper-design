---
// Owner's logo, traced from brand/logo-original.jpg (see src/data/logo.ts).
// variant "inline": small monogram + wordmark side by side (nav/footer).
import { monogram } from '../data/logo';
import { wordmarkTight as wordmark } from '../data/logo-tight';
interface Props { class?: string; size?: 'sm' | 'md' }
const { class: className = '', size = 'sm' } = Astro.props;
const markH = size === 'md' ? 'h-9' : 'h-7';
const wordH = size === 'md' ? 'h-3.5' : 'h-[11px]';
---

<span class:list={['inline-flex items-center gap-3 text-fg', className]}>
  <svg viewBox={monogram.viewBox} class:list={[markH, 'w-auto shrink-0']} aria-hidden="true" focusable="false" fill="currentColor">
    <path fill-rule="evenodd" d={monogram.d}></path>
  </svg>
  <svg viewBox={wordmark.viewBox} class:list={[wordH, 'w-auto']} aria-hidden="true" focusable="false" fill="currentColor">
    <path fill-rule="evenodd" d={wordmark.d}></path>
  </svg>
  <span class="sr-only">Copper Design</span>
</span>
