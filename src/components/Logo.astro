---
// Placeholder wordmark. TODO(owner): replace with the final logo files when available.
interface Props { class?: string; uid?: string }
const { class: className = '', uid = 'logo' } = Astro.props;
const gid = `${uid}-metal`;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={gid} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#8C4E22" />
        <stop offset="0.45" stop-color="#E6B689" />
        <stop offset="1" stop-color="#B87333" />
      </linearGradient>
    </defs>
    <circle cx="16" cy="16" r="15" fill={`url(#${gid})`} />
    <path d="M22.5 10.6a8 8 0 1 0 0 10.8" fill="none" stroke="#14110F" stroke-width="2.6" stroke-linecap="round" />
  </svg>
  <span class="font-display text-lg font-medium tracking-tight">Copper<span class="text-muted font-normal"> Design</span></span>
</span>
