---
import { u } from '../lib/url';
import ProjectArt from './ProjectArt.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index?: number;
  headingLevel?: 'h2' | 'h3';
  delay?: number;
  tall?: boolean;
}
const { project, index, headingLevel = 'h3', delay = 0, tall = false } = Astro.props;
const Heading = headingLevel;
const num = index !== undefined ? String(index + 1).padStart(2, '0') : undefined;
---

<article
  class="group relative overflow-hidden rounded-[1.25rem] border rule bg-card"
  data-reveal
  style={`--reveal-delay:${delay}ms`}
  data-categories={project.categories.join('|')}
>
  <div class:list={['art-zoom relative', tall ? 'aspect-[4/5]' : 'aspect-[4/3.4]']}>
    <ProjectArt variant={project.art} uid={`art-${project.slug}`} label={`Abstract artwork for the concept project: ${project.title}`} />
    <div class="pointer-events-none absolute inset-0" style="background: linear-gradient(to top, #000 0%, rgb(0 0 0 / 0.88) 34%, rgb(0 0 0 / 0.35) 62%, transparent 82%)"></div>
    <span class="absolute left-4 top-4 rounded-full border border-white/15 bg-black/60 px-3 py-1 text-[0.6875rem] font-medium uppercase tracking-[0.16em] text-fg backdrop-blur">Concept</span>
    <div class="absolute inset-x-0 bottom-0 p-5 md:p-6">
      <p class="text-[0.6875rem] uppercase tracking-[0.16em] text-muted">{num && `${num} — `}{project.categories.join(' · ')}</p>
      <Heading class="mt-2 text-xl leading-tight md:text-2xl">
        <a href={u(`/work/${project.slug}/`)} class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none">
          {project.title}
        </a>
      </Heading>
      <p class="mt-2 line-clamp-2 max-w-prose text-sm text-muted">{project.summary}</p>
    </div>
  </div>
</article>

<style>
  article:has(a:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }
</style>
