---
import { packages } from '../data/home';
import { startProjectHref } from '../data/site';
const base = startProjectHref.replace('#enquiry', '');
---

<ul class="grid gap-3 md:grid-cols-2 lg:grid-cols-3">
  {packages.map((p, i) => (
    <li
      class:list={['card relative flex flex-col p-6 md:p-8', p.featured && 'border-line-strong bg-card-hover']}
      data-reveal
      style={`--reveal-delay:${i * 80}ms`}
    >
      {p.featured && <span class="absolute right-6 top-6 rounded-full bg-fg px-3 py-1 text-[0.6875rem] font-semibold uppercase tracking-[0.12em] text-bg">Most complete</span>}
      <h3 class="text-2xl font-medium">{p.name}</h3>
      <p class="mt-2 text-sm text-muted">{p.for}</p>
      {/* TODO(owner): set package prices in src/data/home.ts */}
      <p class="mt-8 text-3xl font-medium tracking-tight" style="font-family: var(--font-heading)">{p.price ?? 'Quoted per project'}</p>
      {!p.price && <p class="mt-1 text-xs text-subtle">Fixed quote after a free discovery call.</p>}
      <ul class="mt-8 space-y-3 border-t rule pt-6 text-sm text-muted">
        {p.includes.map((item) => (
          <li class="flex gap-3">
            <svg class="mt-0.5 shrink-0 text-fg" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 8.5l3 3 7-7"></path></svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
      <a href={`${base}?package=${encodeURIComponent(p.name)}#enquiry`} class:list={['btn mt-8', p.featured ? 'btn-primary' : 'btn-ghost']}>
        Enquire about {p.name}
      </a>
    </li>
  ))}
</ul>
