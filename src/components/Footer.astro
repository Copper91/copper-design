---
import { u } from '../lib/url';
import Logo from './Logo.astro';
import { nav, site, activeSocials } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="mt-32 border-t rule">
  <div class="container-x grid gap-12 py-16 md:grid-cols-12 md:py-20">
    <div class="md:col-span-6">
      <Logo size="md" />
      <p class="mt-6 max-w-sm text-sm text-muted">
        A creative studio for brand identity, graphic design, AI creative and motion graphics.
      </p>
    </div>

    <nav aria-label="Footer" class="md:col-span-3">
      <h2 class="eyebrow eyebrow-plain">Explore</h2>
      <ul class="mt-5 space-y-3 text-sm">
        {nav.filter((i) => i.href !== u('/contact/')).map((i) => <li><a class="link-underline text-muted hover:text-fg" href={i.href}>{i.label}</a></li>)}
        <li><a class="link-underline text-muted hover:text-fg" href={u("/privacy/")}>Privacy</a></li>
      </ul>
    </nav>

    <div class="md:col-span-3">
      <h2 class="eyebrow eyebrow-plain">Connect</h2>
      <ul class="mt-5 space-y-3 text-sm">
        {/* TODO(owner): add real profile URLs in src/data/site.ts; empty ones are hidden. */}
        {activeSocials.map((s) => <li><a class="link-underline text-muted hover:text-fg" href={s.href} rel="me noopener">{s.label}</a></li>)}
        {
          site.email ? (
            <li><a class="link-underline text-muted hover:text-fg" href={`mailto:${site.email}`}>Email</a></li>
          ) : (
            <li><a class="link-underline text-muted hover:text-fg" href={u("/contact/")}>Enquiry form</a></li>
          )
        }
      </ul>
    </div>
  </div>
  <div class="border-t rule">
    <div class="container-x flex flex-col gap-2 py-6 text-xs text-subtle sm:flex-row sm:justify-between">
      <p>&copy; {year} {site.name}. All rights reserved.</p>
      <p>{site.slogan}</p>
    </div>
  </div>
</footer>
