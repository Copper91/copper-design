---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  id?: string;
  as?: 'h1' | 'h2';
}
const { eyebrow, title, intro, id, as = 'h2' } = Astro.props;
const H = as;
---

<div class="grid gap-6 md:grid-cols-12 md:items-end" data-reveal>
  <div class="md:col-span-7">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <H id={id} class="section-title mt-6 max-w-[18ch]">{title}</H>
  </div>
  {intro && <p class="max-w-md text-base text-muted md:col-span-5 md:justify-self-end">{intro}</p>}
</div>
