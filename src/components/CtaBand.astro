---
import { startProjectHref, bookCallHref } from '../data/site';
interface Props { lines?: string[]; text?: string }
const {
  lines = ['Let’s build', 'something', 'exceptional'],
  text = 'Whether you’re launching a brand, producing a campaign, or exploring AI-driven visuals, Copper Design is ready to bring your vision to life.',
} = Astro.props;
---

<section class="relative mt-32 overflow-hidden py-24 md:mt-44 md:py-32" aria-labelledby="cta-title">
  <div aria-hidden="true" class="pointer-events-none absolute left-1/2 top-1/2 h-[36rem] w-[60rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(closest-side,rgb(255_255_255/0.07),transparent)]"></div>
  <div class="container-x relative text-center" data-reveal>
    <h2 id="cta-title" class="display mx-auto text-[clamp(2.6rem,8.5vw,6.5rem)]">
      {lines.map((l) => <span class="block">{l}</span>)}
    </h2>
    <p class="mx-auto mt-8 max-w-xl text-base text-muted">{text}</p>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
      <a href={startProjectHref} class="btn btn-primary">
        Start your project
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
      </a>
      <a href={bookCallHref} class="btn btn-ghost">Book a call</a>
    </div>
  </div>
</section>
