---
import { services } from '../data/services';
interface Props { headingLevel?: 'h2' | 'h3' }
const { headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---

<ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
  {services.map((s, i) => (
    <li class="card card-hover group relative flex min-h-[17rem] flex-col p-6 md:p-7" data-reveal style={`--reveal-delay:${i * 80}ms`}>
      <span class="text-xs text-subtle">{s.number}</span>
      <H class="mt-5 text-lg font-medium">
        <a href={`/services/#${s.slug}`} class="after:absolute after:inset-0 after:rounded-[1.25rem] after:content-[''] focus-visible:outline-none">{s.title}</a>
      </H>
      <p class="mt-3 text-sm text-muted">{s.short}</p>
      <span aria-hidden="true" class="mt-auto pt-8 text-subtle transition-transform duration-300 group-hover:translate-x-1 group-hover:text-fg">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9h12M10 4l5 5-5 5"></path></svg>
      </span>
    </li>
  ))}
</ul>

<style>
  li:has(a:focus-visible) { outline: 2px solid var(--focus); outline-offset: 3px; }
</style>
