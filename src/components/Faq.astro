---
import { faqs } from '../data/home';
---

<div class="divide-y divide-line border-y rule">
  {faqs.map((f) => (
    <details class="faq py-1" data-reveal>
      <summary class="flex items-center justify-between gap-6 py-5 text-lg font-medium md:text-xl" style="font-family: var(--font-heading)">
        <span>{f.q}</span>
        <span class="faq-icon inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-line-strong" aria-hidden="true">
          <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 1v12M1 7h12"></path></svg>
        </span>
      </summary>
      <p class="max-w-3xl pb-6 text-muted">{f.a}</p>
    </details>
  ))}
</div>
