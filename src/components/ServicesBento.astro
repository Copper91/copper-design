---
import { services } from '../data/services';
import { startProjectHref } from '../data/site';
interface Props { headingLevel?: 'h2' | 'h3' }
const { headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
// Bento layout: first tile is the large feature tile.
const spans = [
  'md:col-span-4 md:row-span-2',
  'md:col-span-2',
  'md:col-span-2',
  'md:col-span-3',
  'md:col-span-3',
];
const icons = [
  // brand: circle + C
  '<circle cx="24" cy="24" r="17" /><path d="M31 17.5a9 9 0 1 0 0 13" />',
  // social: grid
  '<rect x="8" y="8" width="13" height="13" rx="3"/><rect x="27" y="8" width="13" height="13" rx="3"/><rect x="8" y="27" width="13" height="13" rx="3"/><rect x="27" y="27" width="13" height="13" rx="3"/>',
  // print: poster
  '<rect x="11" y="6" width="26" height="36" rx="2"/><path d="M16 14h16M16 20h10M16 34h16"/>',
  // web: browser
  '<rect x="6" y="9" width="36" height="30" rx="4"/><path d="M6 17h36M12 13h.01M16 13h.01"/>',
  // AI: spark
  '<path d="M24 6l3.6 10.4L38 20l-10.4 3.6L24 34l-3.6-10.4L10 20l10.4-3.6z"/><path d="M36 32l1.5 4.5L42 38l-4.5 1.5L36 44l-1.5-4.5L30 38l4.5-1.5z"/>',
];
---

<ul class="grid auto-rows-[minmax(14rem,auto)] gap-4 md:grid-cols-6">
  {services.map((s, i) => (
    <li
      class:list={['group relative flex flex-col justify-between overflow-hidden rounded-3xl border rule bg-surface p-6 md:p-8 transition-colors hover:border-[var(--accent-text)]', spans[i]]}
      data-reveal
      style={`--reveal-delay:${i * 70}ms`}
    >
      {i === 0 && (
        <div aria-hidden="true" class="pointer-events-none absolute -bottom-24 -right-24 h-80 w-80 rounded-full opacity-30 blur-2xl" style="background: var(--metal)"></div>
      )}
      <svg width="44" height="44" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="relative text-accent" aria-hidden="true" set:html={icons[i]} />
      <div class="relative mt-10">
        <H class:list={['font-display leading-tight', i === 0 ? 'text-3xl md:text-5xl' : 'text-2xl']}>
          <a href={`/services/#${s.slug}`} class="after:absolute after:inset-0 after:content-['']">{s.title}</a>
        </H>
        <p class:list={['mt-3 text-muted', i === 0 ? 'max-w-md text-base md:text-lg' : 'text-sm']}>{i === 0 ? s.summary : s.short}</p>
      </div>
    </li>
  ))}
  <li class="relative flex flex-col justify-between rounded-3xl p-6 md:col-span-6 md:flex-row md:items-center md:p-8" style="background: var(--metal)" data-reveal>
    <p class="font-display text-2xl leading-tight text-[#1E1A17] md:text-3xl">Not sure which you need? Most projects mix a few.</p>
    <a href={startProjectHref} class="btn mt-6 bg-[#1E1A17] text-[#FAF7F3] hover:bg-black md:mt-0">Tell us about it</a>
  </li>
</ul>
