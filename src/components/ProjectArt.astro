---
// Original generative SVG artwork for the sample/concept projects. No stock imagery.
import type { Project } from '../data/projects';

interface Props {
  variant: Project['art'];
  uid: string;
  label: string;
  class?: string;
}

const { variant, uid, label, class: className = '' } = Astro.props;
const id = (n: string) => `${uid}-${n}`;
const url = (n: string) => `url(#${id(n)})`;

// Deterministic helpers
const arcs = Array.from({ length: 11 }, (_, i) => 70 + i * 46);
const contours = Array.from({ length: 16 }, (_, i) => {
  const y = 90 + i * 30;
  const a = 26 + (i % 5) * 7;
  return `M-20 ${y} C 160 ${y - a}, 260 ${y + a * 1.6}, 420 ${y} S 700 ${y - a * 1.4}, 820 ${y + 10}`;
});
const petals = Array.from({ length: 12 }, (_, i) => i * 30);
const tiles = [
  { x: 60, y: 60, w: 220, h: 220, f: 'copper', r: 28, shape: 'circle' },
  { x: 300, y: 60, w: 210, h: 100, f: 'cream', r: 22 },
  { x: 530, y: 60, w: 210, h: 220, f: 'patina', r: 28, shape: 'stripes' },
  { x: 300, y: 180, w: 210, h: 100, f: 'ink2', r: 22, shape: 'bar' },
  { x: 60, y: 300, w: 450, h: 240, f: 'ink2', r: 28, shape: 'type' },
  { x: 530, y: 300, w: 210, h: 240, f: 'copper', r: 28, shape: 'half' },
];
const fills: Record<string, string> = { copper: url('metal'), cream: '#e6e6e6', patina: '#5c5c5c', ink2: '#1d1d1d' };
---

<svg
  viewBox="0 0 800 600"
  role="img"
  aria-label={label}
  preserveAspectRatio="xMidYMid slice"
  class:list={['block h-full w-full', className]}
>
  <defs>
    <linearGradient id={id('metal')} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#262626" />
      <stop offset="0.35" stop-color="#8a8a8a" />
      <stop offset="0.55" stop-color="#f2f2f2" />
      <stop offset="0.75" stop-color="#9a9a9a" />
      <stop offset="1" stop-color="#1f1f1f" />
    </linearGradient>
    <radialGradient id={id('glow')} cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#f2f2f2" stop-opacity="0.9" />
      <stop offset="0.5" stop-color="#bdbdbd" stop-opacity="0.35" />
      <stop offset="1" stop-color="#bdbdbd" stop-opacity="0" />
    </radialGradient>
    <linearGradient id={id('patina')} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#3a3a3a" />
      <stop offset="0.5" stop-color="#cfcfcf" />
      <stop offset="1" stop-color="#1c1c1c" />
    </linearGradient>
    <filter id={id('grain')} x="0" y="0" width="100%" height="100%">
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch" />
      <feColorMatrix type="saturate" values="0" />
      <feComponentTransfer><feFuncA type="table" tableValues="0 0.08" /></feComponentTransfer>
      <feBlend in="SourceGraphic" mode="overlay" />
    </filter>
  </defs>

  {
    variant === 'arcs' && (
      <g>
        <rect width="800" height="600" fill="#0c0c0c" />
        <circle cx="560" cy="210" r="260" fill={url('glow')} />
        {arcs.map((r, i) => (
          <circle cx="120" cy="620" r={r} fill="none" stroke={url('metal')} stroke-width={i % 3 === 0 ? 3 : 1.2} opacity={1 - i * 0.07} />
        ))}
        <circle cx="560" cy="210" r="74" fill={url('metal')} />
        <path d="M600 180a50 50 0 1 0 0 60" fill="none" stroke="#0c0c0c" stroke-width="12" stroke-linecap="round" />
      </g>
    )
  }

  {
    variant === 'grid' && (
      <g>
        <rect width="800" height="600" fill="#0e0e0e" />
        {tiles.map((t) => (
          <g>
            <rect x={t.x} y={t.y} width={t.w} height={t.h} rx={t.r} fill={fills[t.f]} />
            {t.shape === 'circle' && <circle cx={t.x + t.w / 2} cy={t.y + t.h / 2} r="64" fill="#0e0e0e" />}
            {t.shape === 'stripes' &&
              [0, 1, 2, 3, 4].map((k) => <rect x={t.x + 28} y={t.y + 34 + k * 34} width={t.w - 56 - k * 22} height="12" rx="6" fill="#e6e6e6" opacity="0.85" />)}
            {t.shape === 'bar' && <rect x={t.x + 24} y={t.y + 42} width={t.w - 48} height="16" rx="8" fill={url('metal')} />}
            {t.shape === 'type' && (
              <g>
                <rect x={t.x + 36} y={t.y + 48} width="250" height="36" rx="8" fill="#e6e6e6" />
                <rect x={t.x + 36} y={t.y + 100} width="330" height="36" rx="8" fill="#e6e6e6" />
                <rect x={t.x + 36} y={t.y + 172} width="120" height="28" rx="14" fill={url('metal')} />
              </g>
            )}
            {t.shape === 'half' && <path d={`M${t.x} ${t.y + t.h} a${t.w / 2} ${t.w / 2} 0 0 1 ${t.w} 0Z`} fill="#0e0e0e" opacity="0.85" />}
          </g>
        ))}
      </g>
    )
  }

  {
    variant === 'poster' && (
      <g>
        <rect width="800" height="600" fill="#e9e9e9" />
        <g transform="rotate(-6 400 300)">
          <rect x="120" y="40" width="300" height="440" fill="#9a9a9a" />
          <rect x="300" y="110" width="300" height="440" fill="#3a3a3a" />
          <rect x="470" y="70" width="230" height="330" fill="#111111" />
        </g>
        <text x="60" y="400" font-family="'Archivo Variable', 'Arial Black', sans-serif" font-size="300" font-weight="800" fill="#111111" letter-spacing="-18">14</text>
        <text x="420" y="560" font-family="'Archivo Variable', 'Arial Black', sans-serif" font-size="300" font-weight="800" fill="#e6e6e6" letter-spacing="-18">21</text>
        <rect x="60" y="460" width="300" height="6" fill="#111111" />
      </g>
    )
  }

  {
    variant === 'interface' && (
      <g>
        <rect width="800" height="600" fill="#121212" />
        <circle cx="180" cy="120" r="220" fill={url('glow')} opacity="0.55" />
        <rect x="250" y="60" width="300" height="560" rx="44" fill="#1f1f1f" stroke="#333333" stroke-width="2" />
        <rect x="272" y="84" width="256" height="520" rx="30" fill="#efefef" />
        <rect x="296" y="116" width="120" height="14" rx="7" fill="#111111" opacity="0.8" />
        <rect x="296" y="142" width="80" height="10" rx="5" fill="#7a7a7a" opacity="0.6" />
        <rect x="296" y="178" width="208" height="130" rx="20" fill={url('metal')} />
        <path d="M312 280 C 350 250, 380 270, 410 235 S 470 215, 490 200" fill="none" stroke="#efefef" stroke-width="4" stroke-linecap="round" />
        {[0, 1, 2].map((k) => (
          <g>
            <rect x="296" y={334 + k * 66} width="208" height="52" rx="14" fill="#dedede" />
            <circle cx="322" cy={360 + k * 66} r="12" fill={k === 1 ? '#5c5c5c' : '#9a9a9a'} />
            <rect x="344" y={352 + k * 66} width="90" height="8" rx="4" fill="#111111" opacity="0.7" />
            <rect x="344" y={366 + k * 66} width="56" height="6" rx="3" fill="#7a7a7a" opacity="0.5" />
          </g>
        ))}
        <rect x="560" y="200" width="190" height="120" rx="22" fill="#efefef" opacity="0.96" />
        <rect x="582" y="224" width="70" height="10" rx="5" fill="#7a7a7a" opacity="0.6" />
        <rect x="582" y="246" width="120" height="22" rx="6" fill="#111111" opacity="0.85" />
        <rect x="582" y="284" width="146" height="10" rx="5" fill={url('patina')} />
        <rect x="56" y="380" width="170" height="96" rx="22" fill="#efefef" opacity="0.96" />
        <circle cx="96" cy="428" r="20" fill={url('metal')} />
        <rect x="128" y="414" width="70" height="10" rx="5" fill="#111111" opacity="0.75" />
        <rect x="128" y="434" width="48" height="8" rx="4" fill="#7a7a7a" opacity="0.5" />
      </g>
    )
  }

  {
    variant === 'bloom' && (
      <g>
        <rect width="800" height="600" fill="#0a0a0a" />
        <circle cx="400" cy="300" r="300" fill={url('glow')} opacity="0.5" />
        <g transform="translate(400 300)">
          {petals.map((a, i) => (
            <ellipse cx="0" cy="-120" rx="52" ry="130" fill={i % 2 ? url('patina') : url('metal')} opacity="0.78" transform={`rotate(${a})`} />
          ))}
          <circle r="54" fill="#f2f2f2" />
          <circle r="26" fill="#0a0a0a" opacity="0.4" />
        </g>
      </g>
    )
  }

  {
    variant === 'waves' && (
      <g>
        <rect width="800" height="600" fill="#0d0d0d" />
        {contours.map((d, i) => (
          <path d={d} fill="none" stroke={i % 4 === 0 ? url('metal') : '#cfcfcf'} stroke-width={i % 4 === 0 ? 2.4 : 1} opacity={i % 4 === 0 ? 1 : 0.45} />
        ))}
        <rect x="520" y="92" width="200" height="260" fill="none" stroke="#e6e6e6" stroke-width="1.5" />
        <rect x="560" y="132" width="120" height="180" fill={url('metal')} opacity="0.92" />
      </g>
    )
  }

  <rect width="800" height="600" fill="transparent" filter={url('grain')} />
</svg>
