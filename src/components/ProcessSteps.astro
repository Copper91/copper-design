---
import { process } from '../data/home';
---

<ol class="grid gap-px overflow-hidden rounded-3xl border rule bg-[var(--line)] md:grid-cols-4">
  {process.map((p, i) => (
    <li class="flex flex-col bg-paper p-6 md:p-8" data-reveal style={`--reveal-delay:${i * 90}ms`}>
      <span class="font-display text-5xl text-accent md:text-6xl" aria-hidden="true">{p.step}</span>
      <h3 class="mt-8 font-display text-2xl"><span class="sr-only">Step {i + 1}: </span>{p.title}</h3>
      <p class="mt-3 text-sm text-muted">{p.text}</p>
    </li>
  ))}
</ol>
