---
import { disciplines } from '../data/home';
---

<section aria-label="What we design" class="border-y rule py-6 md:py-8">
  <div class="marquee">
    <ul class="marquee-track font-display text-2xl md:text-4xl">
      {disciplines.map((d) => (
        <li class="flex items-center gap-12 whitespace-nowrap">
          <span>{d}</span><span class="text-accent" aria-hidden="true">✦</span>
        </li>
      ))}
      {disciplines.map((d) => (
        <li class="flex items-center gap-12 whitespace-nowrap" aria-hidden="true">
          <span>{d}</span><span class="text-accent">✦</span>
        </li>
      ))}
    </ul>
  </div>
</section>
